# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# --- Модель (любой OpenAI-совместимый адрес: Yandex AI Studio, AI Tunnel, Alibaba, локальный vLLM) ---
LLM_BASE_URL=https://api.aitunnel.ru/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-35b-a3b
# Независимый проверяющий (строгий режим и оценка качества)
JUDGE_MODEL=qwen3.5-122b-a10b
# Цены официального провайдера модели (Alibaba Cloud) для расчёта стоимости, $ за 1 млн токенов
LLM_PRICE_INPUT_USD_PER_M=0.375
LLM_PRICE_OUTPUT_USD_PER_M=2.25
USD_RUB=82
# Дневной лимит расходов на модель, ₽ (защита публичного стенда)
LLM_DAILY_BUDGET_RUB=500

# --- Эмбеддинги: локально (BGE-M3 на CPU) ---
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DEVICE=cpu
EMBEDDINGS_BACKEND=sentence-transformers

# --- База ---
# В Docker Compose адрес базы задаётся автоматически; пароль базы:
POSTGRES_PASSWORD=change-me

# --- Почта агента ---
MAIL_SMTP_HOST=smtp.example.ru
MAIL_SMTP_PORT=465
MAIL_IMAP_HOST=imap.example.ru
MAIL_IMAP_PORT=993
MAIL_USER=agent@example.ru
MAIL_PASSWORD=
MAIL_BACKEND=imap
MAIL_POLL_SECONDS=20
# Адрес службы качества (для демо - тестовый ящик)
QUALITY_EMAIL=quality@example.ru
# Кто вправе дать финальный ответ: адреса или @домены через запятую (служба качества)
QUALITY_AUTHORIZED_SENDERS=

# --- Паспорт компании и документы ---
PASSPORT_PATH=passports/softline.yaml
REGULATIONS_DIR=data/regulations

# --- Обезличивание ПДн перед вызовом внешней модели ---
PII_MASKING=true

# --- Интерфейс ---
DOMAIN=reglament-agent.more-tech.ru
PUBLIC_BASE_URL=https://reglament-agent.more-tech.ru
# Токен кабинета службы качества (пусто - кабинет открыт, для демо жюри)
ADMIN_TOKEN=
RATE_LIMIT_PER_MINUTE=20
